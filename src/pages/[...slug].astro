---
import Base from '../layouts/Base.astro';
import Formulario from '../components/Formulario.astro';
import { sanearImagenes } from '../utils/imagenes.js';
import { reconstruir } from '../utils/estructura.js';
import { generarFaq, tituloFaq, renderFaq, marcarFaqAntiguo, colocarFaq, clasificar, LINEAS } from '../utils/faq.js';
import { generarExtras, renderExtras, tablaPrecios, trasPrimerParrafo } from '../utils/extras.js';
import { descripcionSeo, tituloSeo } from '../utils/seo.js';
import { hermanasDe, renderHermanas, directorioDe, completarDirectorio } from '../utils/indice.js';

export async function getStaticPaths() {
  const modulos = import.meta.glob('../content/pages/*.json', { eager: true });
  return Object.values(modulos).map((m) => {
    const pagina = m.default ?? m;
    const slug = pagina.ruta === '/' ? undefined : pagina.ruta.replace(/^\/|\/$/g, '');
    return { params: { slug }, props: { pagina } };
  });
}

const { pagina } = Astro.props;

/* Sustituye por un marcador solo lo que falte en public/. Las rutas
   /wp-content/uploads/ que existen no se tocan nunca. */
/* Además se reconstruye lo que se perdió al migrar desde Elementor: los
   pares título+foto vuelven a ser una rejilla de tarjetas, los enlaces
   sueltos de llamada a la acción vuelven a ser botones, y los directorios
   de localidades vuelven a ser una nube de enlaces en vez de viñetas. */
/* Al final del contenido se AÑADEN (sin tocar lo que había) dos secciones
   nuevas h2 + texto propias de cada página, y detrás las preguntas
   frecuentes en acordeón, en el sitio donde iban en el original. La
   clasificación (línea, tema, localidad) es la misma para las dos. */
const faq = generarFaq(pagina);
const extras = renderExtras(generarExtras(pagina));
/* enlaces a la misma localidad o al mismo tema en las otras lineas */
const hermanas = renderHermanas(hermanasDe(pagina));
const { html: saneado } = sanearImagenes(pagina.cuerpo);
/* el directorio de localidades de la linea, completo (sustituye al que
   traia la pagina o se añade al final) */
const cuerpo = completarDirectorio(
  colocarFaq(
    trasPrimerParrafo(reconstruir(marcarFaqAntiguo(saneado)), tablaPrecios(pagina)), // tabla en las paginas de precios
    extras + hermanas + renderFaq(faq, tituloFaq(pagina)),
  ),
  directorioDe(pagina),
);

/* El cuerpo trae <aside data-formulario="1"></aside> donde estaba el
   Contact Form 7. Se parte por ahí para intercalar el componente. */
const trozos = cuerpo.split(/<aside[^>]*data-formulario="1"[^>]*>\s*<\/aside>/i);

/* La portada del catálogo queda justo detrás del formulario, y su texto
   justo delante: el corte por el formulario las separa, así que no se
   pueden unir en reconstruir(). Suelta se veía como un cuadrado de
   520x520 flotando en medio de un hueco blanco. Aquí se saca del trozo
   siguiente para ponerla AL LADO del formulario, que es justo la
   llamada a la acción para pedir el catálogo. */
/* enlazada y en su <p> (portada y provincias) o suelta y sin enlace (las
   propias páginas de catálogo, que no enlazan a sí mismas) */
const PORTADA = /^\s*(?:<p\b[^>]*>\s*<a\b[^>]*href="[^"]*"[^>]*>\s*<img\b[^>]*>\s*<\/a>\s*<\/p>|<img\b[^>]*>)/i;
const piezas = trozos.map((t, i) => {
  if (i === 0) return { html: t, portada: '' };
  const m = t.match(PORTADA);
  return m ? { html: t.slice(m[0].length), portada: m[0] } : { html: t, portada: '' };
});

/* descripcion natural (meta y entradilla del heroe): las de WordPress
   eran "palabra clave ✅ palabra clave ✅" */
const descripcion = descripcionSeo(pagina);
const entradilla = descripcion;

/* El alt de la foto principal llegaba como el nombre del archivo
   ("casas-prefabricadas-Alava"). Se describe con la palabra clave de la
   página: "Casas prefabricadas de madera en Madrid". */
const { linea, lugar } = clasificar(pagina);
const capitalizar = (s) => (s ? s[0].toUpperCase() + s.slice(1) : s);
const heroAlt = lugar
  ? `${capitalizar(LINEAS[linea].titulo)} en ${lugar}`
  : capitalizar(pagina.palabraClave || pagina.h1 || '');
const hero = pagina.hero ? { ...pagina.hero, alt: heroAlt } : pagina.hero;
---

<Base
  ruta={pagina.ruta}
  titulo={tituloSeo(pagina)}
  descripcion={descripcion}
  encabezado={pagina.h1}
  entradilla={entradilla}
  hero={hero}
  faq={faq}
  noindex={pagina.noindex}
>
  <div class="contenido contenedor">
    {piezas.map((pieza, i) => (
      <>
        <Fragment set:html={pieza.html} />
        {i < piezas.length - 1 && (
          piezas[i + 1].portada ? (
            <div class="peticion">
              <div class="peticion__form">
                <Formulario asunto={`Consulta desde ${pagina.ruta}`} />
              </div>
              <Fragment set:html={`<div class="peticion__portada">${piezas[i + 1].portada}</div>`} />
            </div>
          ) : (
            <Formulario asunto={`Consulta desde ${pagina.ruta}`} />
          )
        )}
      </>
    ))}
  </div>
</Base>
