---
/* Botón flotante de WhatsApp, abajo a la derecha, como el del original
   (plugin "WhatsApp Chat": número, texto y mensaje copiados de ahí). Los
   datos están en src/data/site.json → whatsapp. Sin número, no se pinta. */
import site from '../data/site.json';

const { numero, texto, mensaje } = site.whatsapp || {};
const enlace = numero ? `https://wa.me/${numero}?text=${encodeURIComponent(mensaje || '')}` : '';
---

{enlace && (
  <a class="whatsapp" href={enlace} target="_blank" rel="noopener" aria-label={`WhatsApp: ${texto}`}>
    <svg class="whatsapp__icono" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M16 3C8.8 3 3 8.7 3 15.8c0 2.6.8 5.1 2.2 7.2L3 29l6.2-2.1c2 1.1 4.4 1.7 6.8 1.7 7.2 0 13-5.7 13-12.8S23.2 3 16 3zm0 23.3c-2.2 0-4.3-.6-6.1-1.7l-.4-.3-3.7 1.2 1.2-3.5-.3-.4A10.3 10.3 0 0 1 5.4 15.8C5.4 10 10.2 5.4 16 5.4s10.6 4.7 10.6 10.4S21.8 26.3 16 26.3zm5.8-7.8c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8.6 8.6 0 0 1-2.5-1.6 9.6 9.6 0 0 1-1.8-2.2c-.2-.3 0-.5.1-.6l.5-.6.3-.5c.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4s-1.1 1.1-1.1 2.7 1.2 3.1 1.3 3.3c.2.2 2.3 3.5 5.6 4.9.8.3 1.4.5 1.9.7.8.2 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5-.1-.2-.3-.3-.6-.4z"/>
    </svg>
    <span class="whatsapp__texto">{texto}</span>
  </a>
)}
